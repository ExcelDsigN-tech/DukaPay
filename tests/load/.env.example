# Load Testing Environment Configuration
# Copy this file to .env and fill in the values

# Test Environment (staging, production)
TEST_ENV=staging

# Load Profile (smoke, normal, stress, spike)
LOAD_PROFILE=normal

# Test Duration (short, medium, long)
TEST_DURATION=medium

# API URLs
STAGING_API_URL=https://your-staging-backend.example
STAGING_RPC_URL=https://soroban-testnet.stellar.org
PROD_API_URL=https://your-backend.example
PROD_RPC_URL=https://soroban-testnet.stellar.org

# Authentication (use long-lived test tokens)
TEST_AUTH_TOKEN=your-test-token-here
TEST_API_KEY=your-api-key-here

# Alert Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ALERT_EMAIL=you@example.com

# Git Configuration (for baseline versioning)
GIT_SHA=
BUILD_TIME=
